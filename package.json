{
  "name": "instamosaic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n app,worker -c cyan,magenta \"npm run dev:app\" \"npm run worker:http\"",
    "dev:app": "npm --workspace app run dev",
    "dev:worker": "npm run worker",
    "build": "npm run build --workspaces --if-present",
    "start": "npm --workspace app run start",
    "worker": "tsx packages/worker/src/cli.ts",
    "worker:http": "tsx packages/worker/src/server.ts",
    "db:init": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "marketing:draft": "tsx scripts/marketing-draft.ts",
    "test:check": "tsx scripts/test-check.ts",
    "test:download": "tsx scripts/test-download.ts",
    "test:mosaic": "tsx scripts/test-mosaic.ts",
    "test:reveal": "tsx scripts/test-reveal-video.ts",
    "test:pipeline": "tsx scripts/test-pipeline.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:app",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:app": "tsc -p app/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "playwright": "^1.61.0",
    "prisma": "^7.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@google-cloud/tasks": "^6.2.3",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "archiver": "^8.0.0",
    "dotenv": "^16.5.0",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.2",
    "stripe": "^18.2.1"
  }
}
