{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/*"],
      "@instamosaic/db": ["../packages/db/src/index.ts"],
      "@instamosaic/mosaic": ["../packages/mosaic/src/index.ts"],
      "@instamosaic/mosaic/outputs": ["../packages/mosaic/src/outputs.ts"],
      "@instamosaic/storage": ["../packages/storage/src/index.ts"],
      "@instamosaic/worker": ["../packages/worker/src/index.ts"],
      "@instamosaic/worker/app": ["../packages/worker/src/app.ts"],
      "@instamosaic/worker/profile": ["../packages/worker/src/instagram-profile.ts"],
      "@instamosaic/worker/marketing": ["../packages/worker/src/marketing.ts"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/app/**/*",
    "src/components/**/*",
    "src/lib/**/*",
    "src/routes/api/**/*"
  ]
}
